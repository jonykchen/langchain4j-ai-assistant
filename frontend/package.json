{
  "name": "langchain4j-ai-assistant-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend for LangChain4j AI Assistant - A production-ready AI assistant platform",
  "author": {
    "name": "Jony Chen",
    "email": "jony.k.chen@gmail.com",
    "url": "https://github.com/jonykchen"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonykchen/langchain4j-ai-assistant.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/jonykchen/langchain4j-ai-assistant/issues"
  },
  "homepage": "https://github.com/jonykchen/langchain4j-ai-assistant#readme",
  "keywords": [
    "vue3",
    "typescript",
    "element-plus",
    "ai",
    "chat",
    "langchain4j",
    "assistant"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,js,jsx,json,css,scss,md}\"",
    "type-check": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^11.0.0",
    "axios": "^1.6.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.5.0",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@playwright/test": "^1.40.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.41",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "globals": "^17.6.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.10",
    "vue-tsc": "^2.0.0"
  }
}
