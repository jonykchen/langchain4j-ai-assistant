# ==================== LangChain4j Chat 环境变量配置模板 ====================
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到 Git 仓库

# ==================== 数据库配置 ====================
POSTGRES_USER=langchain4j
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=langchain4j
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/langchain4j?currentSchema=public
DATABASE_USERNAME=langchain4j
DATABASE_PASSWORD=your-secure-password-here

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT 配置 ====================
# JWT 密钥必须至少 32 字符，建议使用随机生成
# 生成方式: openssl rand -base64 32
JWT_SECRET=REDACTED_JWT_SECRET

# ==================== AI 模型 API Keys ====================
# 至少配置一个 AI 模型 API Key

# 阿里云 DashScope（推荐）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# 智谱 GLM（备用）
ZHIPU_API_KEY=your-zhipu-api-key

# DeepSeek（备用）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 硅基流动（备用）
SILICONFLOW_API_KEY=your-siliconflow-api-key

# ==================== Nacos 数据库配置 ====================
MYSQL_ROOT_PASSWORD=your-mysql-root-password
NACOS_DB_USER=nacos
NACOS_DB_PASSWORD=your-nacos-db-password

# ==================== Grafana 配置 ====================
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password

# ==================== OAuth 配置（可选）====================
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitLab OAuth
GITLAB_CLIENT_ID=your-gitlab-client-id
GITLAB_CLIENT_SECRET=your-gitlab-client-secret
GITLAB_URL=https://gitlab.com

# ==================== 应用配置 ====================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082

# ==================== 代理配置（可选）====================
OAUTH_PROXY_HOST=127.0.0.1
OAUTH_PROXY_PORT=7890
