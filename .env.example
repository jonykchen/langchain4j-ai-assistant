# ==================== 环境变量配置模板 ====================
#
# 使用方式：
# 1. 复制此文件为 .env
# 2. 填入实际值
# 3. 确保 .env 已在 .gitignore 中（不要提交敏感信息）
#
# 注意：Docker Compose 会自动读取 .env 文件

# ==================== 必需配置 ====================

# 阿里云 DashScope API Key（主模型）
# 获取方式：阿里云控制台 → 模型服务灵积 → API-KEY 管理
DASHSCOPE_API_KEY=your-api-key-here

# ==================== 备用模型配置（高可用） ====================

# 智谱 GLM API Key
# 获取方式：https://open.bigmodel.cn/
ZHIPU_API_KEY=

# DeepSeek API Key
# 获取方式：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 硅基流动 API Key
# 获取方式：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# ==================== 数据库配置 ====================

# PostgreSQL 数据库（生产环境）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=langchain4j

# ==================== Redis 配置（分布式限流） ====================

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ==================== OAuth 认证配置 ====================

# GitHub OAuth
# 获取方式：https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitLab OAuth（可选）
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_URL=https://gitlab.com

# ==================== JWT 配置 ====================

# JWT 密钥（生产环境请使用安全的随机字符串，至少 32 字符）
JWT_SECRET=your-256-bit-secret-key-must-be-at-least-32-characters-long

# ==================== Nacos 配置中心 ====================

NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=dev
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=langchain4j-chat.properties

# ==================== 可选配置 ====================

# 服务端口（默认 8082）
# SERVER_PORT=8082

# 运行环境：dev / prod（默认 dev）
# SPRING_PROFILES_ACTIVE=dev

# LangChain4j 日志级别（默认 DEBUG）
# LOG_LEVEL_LANGCHAIN4J=DEBUG

# 模型配置（默认 qwen-plus）
# DASHSCOPE_MODEL_NAME=qwen-plus
# MODEL_TEMPERATURE=0.7
# MODEL_MAX_TOKENS=4096

# 链路追踪采样率（生产环境默认 0.1）
# TRACING_SAMPLING_PROBABILITY=0.1

# ==================== Grafana 配置 ====================

# Grafana 管理员密码
# GF_SECURITY_ADMIN_PASSWORD=REDACTED_ADMIN_PASSWORD
