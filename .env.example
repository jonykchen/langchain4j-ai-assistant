# ==================== 环境变量配置示例 ====================
#
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
#
# Docker Compose 会自动读取 .env 文件中的变量

# ==================== AI 模型 API Keys ====================
# 必填：阿里云 DashScope（主模型）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 可选：备用模型 API Keys
ZHIPU_API_KEY=your-zhipu-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
SILICONFLOW_API_KEY=your-siliconflow-api-key

# ==================== 数据库配置 ====================
# PostgreSQL
POSTGRES_USER=langchain4j
POSTGRES_PASSWORD=REDACTED_DB_PASSWORD

# MySQL（Nacos）
MYSQL_ROOT_PASSWORD=REDACTED_ROOT_PASSWORD
NACOS_DB_USER=nacos
NACOS_DB_PASSWORD=REDACTED_NACOS_PASSWORD

# ==================== Redis 配置 ====================
REDIS_PASSWORD=

# ==================== Nacos 配置 ====================
NACOS_SERVER_ADDR=localhost:8848
# 命名空间（留空表示 public，或填写已创建的命名空间 ID）
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# ==================== 监控配置 ====================
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REDACTED_ADMIN_PASSWORD

# ==================== JWT 配置 ====================
# JWT 密钥（必须至少 32 字符，建议使用随机生成的密钥）
JWT_SECRET=REDACTED_JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=604800

# ==================== OAuth 配置（可选） ====================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_URL=https://gitlab.com

# ==================== 消息队列配置（可选） ====================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=REDACTED_ADMIN_PASSWORD

# ==================== 开发环境配置 ====================
# 后端端口
SERVER_PORT=8082

# 日志级别
LOG_LEVEL_LANGCHAIN4J=DEBUG
JPA_SHOW_SQL=false

# H2 控制台（开发环境）
H2_CONSOLE_ENABLED=true

# ==================== 数据库 URL（覆盖默认） ====================
# 使用 PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/langchain4j
DATABASE_USERNAME=langchain4j
DATABASE_PASSWORD=REDACTED_DB_PASSWORD
DATABASE_DRIVER=org.postgresql.Driver

# 使用 Redis
REDIS_HOST=localhost
REDIS_PORT=6379
