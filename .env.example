# ==================== 环境变量配置模板 ====================
#
# 使用方式：
# 1. 复制此文件为 .env
# 2. 填入实际值
# 3. 确保 .env 已在 .gitignore 中（不要提交敏感信息）
#
# 注意：Docker Compose 会自动读取 .env 文件

# ==================== 必需配置 ====================

# 阿里云 DashScope API Key
# 获取方式：阿里云控制台 → 模型服务灵积 → API-KEY 管理
DASHSCOPE_API_KEY=your-api-key-here

# ==================== Redis 配置（分布式限流） ====================

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ==================== Nacos 配置中心 ====================

NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=dev
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=langchain4j-chat.properties

# ==================== 可选配置 ====================

# 服务端口（默认 8082）
# SERVER_PORT=8082

# 运行环境：dev / prod（默认 dev）
# SPRING_PROFILES_ACTIVE=dev

# LangChain4j 日志级别（默认 DEBUG）
# LOG_LEVEL_LANGCHAIN4J=DEBUG

# 模型配置（默认 qwen-plus）
# DASHSCOPE_MODEL_NAME=qwen-plus
# MODEL_TEMPERATURE=0.7
# MODEL_MAX_TOKENS=4096

# 链路追踪采样率（生产环境默认 0.1）
# TRACING_SAMPLING_PROBABILITY=0.1

# ==================== Grafana 配置 ====================

# Grafana 管理员密码
# GF_SECURITY_ADMIN_PASSWORD=REDACTED_ADMIN_PASSWORD