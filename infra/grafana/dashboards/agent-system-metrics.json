{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Agent 执行概览",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "活跃执行数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "agent_active_executions",
          "legendFormat": "全局活跃",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 18 }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "执行成功率",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "rate(agent_executions_total{status=\"success\"}[5m]) / rate(agent_executions_total{status=\"total\"}[5m]) * 100",
          "legendFormat": "成功率",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "title": "执行 QPS",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "rate(agent_executions_total{status=\"success\"}[1m])",
          "legendFormat": "成功",
          "refId": "A"
        },
        {
          "expr": "rate(agent_executions_total{status=\"failure\"}[1m])",
          "legendFormat": "失败",
          "refId": "B"
        },
        {
          "expr": "rate(agent_executions_total{status=\"cancelled\"}[1m])",
          "legendFormat": "取消",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "执行时长 (P50/P90/P99)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(agent_execution_duration_bucket[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, rate(agent_execution_duration_bucket[5m]))",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(agent_execution_duration_bucket[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "title": "按 Agent 细分",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "title": "各 Agent 执行数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "rate(agent_executions_by_agent{status=\"success\"}[5m])",
          "legendFormat": "{{agent}} 成功",
          "refId": "A"
        },
        {
          "expr": "rate(agent_executions_by_agent{status=\"failure\"}[5m])",
          "legendFormat": "{{agent}} 失败",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "各 Agent 活跃执行数",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "agent_active_executions_by_agent",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      }
    },
    {
      "title": "工具调用",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "title": "工具调用 QPS",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "rate(agent_tool_calls_total{status=\"success\"}[1m])",
          "legendFormat": "成功",
          "refId": "A"
        },
        {
          "expr": "rate(agent_tool_calls_total{status=\"failure\"}[1m])",
          "legendFormat": "失败",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "工具执行时长 (P90)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "histogram_quantile(0.9, rate(agent_tool_execution_duration_bucket[5m]))",
          "legendFormat": "P90",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "title": "各工具调用频率",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "rate(agent_tool_calls_by_tool[5m])",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "工具成功率",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "rate(agent_tool_calls_by_tool{status=\"success\"}[5m]) / rate(agent_tool_calls_by_tool[5m]) * 100",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "title": "路由与委托",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "title": "路由目标分布",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "rate(agent_routing_targets[5m])",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "路由置信度分布",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "targets": [
        {
          "expr": "rate(agent_routing_confidence[5m])",
          "legendFormat": "{{bucket}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "委托调用统计",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        {
          "expr": "rate(agent_delegations_total{status=\"success\"}[5m])",
          "legendFormat": "成功/秒",
          "refId": "A"
        },
        {
          "expr": "rate(agent_delegations_total{status=\"failure\"}[5m])",
          "legendFormat": "失败/秒",
          "refId": "B"
        },
        {
          "expr": "rate(agent_routing_low_confidence[5m])",
          "legendFormat": "低置信度/秒",
          "refId": "C"
        }
      ]
    },
    {
      "title": "安全与限流",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }
    },
    {
      "title": "限流触发趋势",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "targets": [
        {
          "expr": "rate(agent_rate_limit_hits_total[5m])",
          "legendFormat": "全局",
          "refId": "A"
        },
        {
          "expr": "rate(agent_rate_limit_hits_by_type[5m])",
          "legendFormat": "{{type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "title": "错误类型分布",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "targets": [
        {
          "expr": "rate(agent_errors_total[5m])",
          "legendFormat": "{{agent}}/{{type}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
