{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "reviewers": ["jonykchen"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "Disable major version updates"
    },
    {
      "matchManagers": ["maven"],
      "groupName": "Java dependencies"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "Node.js dependencies"
    }
  ],
  "ignoreDeps": [],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2
}
