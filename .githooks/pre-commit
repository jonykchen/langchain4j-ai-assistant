#!/bin/bash
#
# Pre-commit hook
# 在提交前检查代码质量
#

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# 1. 检查敏感信息
echo "Checking for sensitive data..."
if git diff --cached --name-only | xargs grep -l -E "(password|secret|api.?key|token)\s*=\s*['\"][^'\"]+['\"]" 2>/dev/null; then
    echo -e "${RED}Error: Potential sensitive data detected!${NC}"
    echo "Please remove hardcoded secrets before committing."
    exit 1
fi
echo -e "${GREEN}✓ No sensitive data found${NC}"

# 2. 检查大文件
echo "Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only | xargs -I {} sh -c 'if [ -f "{}" ]; then stat -f%z "{}" 2>/dev/null || stat -c%s "{}" 2>/dev/null; fi' | awk '$1 > 1048576')
if [ -n "$LARGE_FILES" ]; then
    echo -e "${YELLOW}Warning: Large files detected (>1MB)${NC}"
fi
echo -e "${GREEN}✓ File size check passed${NC}"

# 3. 检查 TODO/FIXME
echo "Checking for TODO/FIXME comments..."
TODOS=$(git diff --cached | grep -E "^\+.*TODO|^\+.*FIXME" | head -5)
if [ -n "$TODOS" ]; then
    echo -e "${YELLOW}Reminder: You have TODO/FIXME comments${NC}"
    echo "$TODOS"
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0
