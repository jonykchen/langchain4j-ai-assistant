#!/bin/bash
#
# Commit message hook
# 验证提交信息格式
#

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 有效的提交类型
VALID_TYPES="feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert"

# 检查提交信息格式
if ! echo "$COMMIT_MSG" | grep -qE "^($VALID_TYPES)(\(.+\))?: .{1,}"; then
    echo -e "${RED}Error: Invalid commit message format!${NC}"
    echo ""
    echo "Commit message must follow this format:"
    echo "  <type>(<scope>): <subject>"
    echo ""
    echo "Valid types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
    echo ""
    echo "Examples:"
    echo "  feat: add new feature"
    echo "  fix: resolve bug in chat"
    echo "  docs: update README"
    echo "  refactor(api): optimize response handling"
    exit 1
fi

echo -e "${GREEN}✓ Commit message format is valid${NC}"
exit 0
