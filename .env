# ==================== 环境变量配置 ====================
#
# 注意：此文件包含敏感信息，已添加到 .gitignore，请勿提交到代码仓库

# ==================== Nacos 日志配置 ====================
# 禁用 Nacos 内置 logback 配置，避免与项目 logback-spring.xml 冲突
NACOS_LOGGING_DEFAULT_CONFIG_ENABLED=false

# ==================== 主模型：阿里云 DashScope ====================
DASHSCOPE_API_KEY=sk-7a5a4473f7794045ab763962402e608e

# ==================== 备用模型：智谱 GLM ====================
ZHIPU_API_KEY=REDACTED_ZHIPU_API_KEY

# ==================== 其他备用模型 ====================
# DeepSeek API Key
DEEPSEEK_API_KEY=REDACTED_DEEPSEEK_API_KEY

# 硅基流动 API Key
SILICONFLOW_API_KEY=REDACTED_DEEPSEEK_API_KEY

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== Nacos 配置中心 ====================
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=dev
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=langchain4j-chat.properties

# ==================== 运行环境 ====================
SPRING_PROFILES_ACTIVE=dev

# ==================== OAuth 配置 ====================
# GitHub OAuth（密钥通过环境变量注入）
GITHUB_CLIENT_ID=5eadeb5842247dd26605
GITHUB_CLIENT_SECRET=5a2b893725f74b0aaa04b1433272f34f5cabad45

# ==================== Gitee 配置 ====================
# 从 https://gitee.com/profile/personal_access_tokens 获取
GITEE_TOKEN=f643b19648aac9eded766494ac04c0ee
GITEE_OWNER=jonykchen
GITEE_REPO=langchain4j-demo
